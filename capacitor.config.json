{
  "appId": "com.thaijashe.app",
  "appName": "Thai Jashe",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#1E2A78"
  },
  "server": {
    "androidScheme": "https",
    "url": "https://thaijaishe.github.io/thai-jashe/",
    "errorPath": "offline.html"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    }
  }
}